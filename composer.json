{
	"name": "citomni/app-skeleton",
	"description": "Neutral application skeleton for CitOmni. Provides the app container, core wiring points, and installer lifecycle tooling without assuming HTTP or CLI mode.",
	"type": "project",
	"license": "MIT",
	"keywords": [
		"app-skeleton",
		"application-template",
		"citomni",
		"citomni-framework",
		"citomni-php",
		"composer",
		"create-project",
		"framework",
		"php",
		"php-framework",
		"skeleton",
		"application-skeleton",
		"lightweight-framework"
	],
	"homepage": "https://www.citomni.com",
	"support": {
		"issues": "https://github.com/citomni/app-skeleton/issues",
		"source": "https://github.com/citomni/app-skeleton"
	},
	"require": {
		"php": "^8.5",
		"citomni/kernel": "^1.0",
		"citomni/installer": "^1.0"
	},
	"suggest": {
		"citomni/http": "Add HTTP mode for web apps, APIs, intranets, and SaaS applications.",
		"citomni/cli": "Add CLI mode for console commands, jobs, cron tasks, and developer tooling.",
		"citomni/infrastructure": "Add lean infrastructure services such as db, log, txt, mailer, and formatting helpers."
	},
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"scripts": {
		"citomni:doctor": "vendor/bin/citomni-installer doctor",
		"citomni:status": "vendor/bin/citomni-installer status",
		"citomni:install": "vendor/bin/citomni-installer install",
		"citomni:sync": "vendor/bin/citomni-installer sync",
		"citomni:repair": "vendor/bin/citomni-installer repair",
		"citomni:diff": "vendor/bin/citomni-installer diff"
	}
}
